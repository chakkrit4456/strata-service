# PostgreSQL บนเครื่องเดียวกัน
DATABASE_URL=postgres://strata:change-me@127.0.0.1:5432/strata

# AI ฟรี — https://aistudio.google.com/apikey และ https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# เจ้าของ — สร้าง hash ด้วย: npm run hash-password -- "รหัสผ่าน"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# สุ่มอย่างน้อย 32 ตัวอักษร
SESSION_SECRET=

# แจ้งเตือนเมื่อลูกค้ายืนยัน Requirement (ไม่ใส่ = ไม่ส่ง)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

UPLOAD_DIR=./uploads
# URL จริงของเว็บ ใช้สร้างลิงก์ในแจ้งเตือน
PUBLIC_URL=http://localhost:3000
